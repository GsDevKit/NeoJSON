SmalltalkCISpec {
    #name : 'NeoJSON for GemStone',
    #loading : [
        SCIMetacelloLoadSpec {
            #baseline : 'NeoJSON',
            #directory : 'filetree',
            #load : [ 'Core', 'Tests' ],
            #onConflict : #useIncoming,
            #onWarningLog : true,
            #platforms : [ #gemstone ],
            #repository : 'https://github.com/GsDevKit/NeoJSON',
            #useLatestMetacello : true
        }
    ]
}
}
